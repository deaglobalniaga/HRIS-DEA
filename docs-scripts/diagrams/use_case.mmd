graph LR;
    Pegawai((Pegawai))
    HRD((HRD))
    
    subgraph Sistem HRIS
        Login([Login])
        CheckIn([Check-In Face API])
        CheckOut([Check-Out Face API])
        AjukanCuti([Ajukan Cuti/Izin])
        Riwayat([Lihat Riwayat Presensi])
        Dashboard([Lihat Dashboard Analitik])
        KelolaKaryawan([Kelola Data Karyawan])
        SetujuCuti([Setujui/Tolak Cuti])
        Laporan([Unduh Laporan PDF])
        KameraGPS([Izin Kamera & GPS])
        Dokumen([Unggah Dokumen])
    end
    
    Pegawai --> Login
    Pegawai --> CheckIn
    Pegawai --> CheckOut
    Pegawai --> AjukanCuti
    Pegawai --> Riwayat
    
    HRD --> Login
    HRD --> Dashboard
    HRD --> KelolaKaryawan
    HRD --> SetujuCuti
    HRD --> Laporan
    
    CheckIn -.->|include| KameraGPS
    AjukanCuti -.->|extend| Dokumen
