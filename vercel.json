{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "BackEnd/**,node_modules/**"
        }
    },
    "buildCommand": "npm install && cd FrontEnd && npm install && npm run build",
    "outputDirectory": "FrontEnd/dist"
}